# ============================================
# WeatherFlow - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================

# --- Server ---
PORT=3000
NOTIFICATIONS_PORT=3001
# Comma-separated browser origins for the Web UI (Vite dev: 5174, Docker: 8080).
# In dev (NODE_ENV != production), any http://localhost:<port> is also allowed.
CORS_ORIGINS=http://localhost:5174,http://localhost:8080

# --- Database ---
# Docker Compose defaults to mongodb://mongo:27017/weatherflow when this is unset.
# Use MongoDB Atlas here when you want the services to connect to a remote database.
MONGODB_URI=mongodb://mongo:27017/weatherflow

# --- Authentication ---
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# --- Service Boundaries ---
# --- Local Notification Service ---
# NOTIFICATION_SERVICE_URL=http://localhost:3001 
# --- Distributed Notification Service ---
NOTIFICATION_SERVICE_URL=http://notifications:3001

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=weatherflow
RABBITMQ_DEFAULT_PASS=weatherflow
RABBITMQ_URL=amqp://weatherflow:weatherflow@rabbitmq:5672
RABBITMQ_ALERT_EXCHANGE=weatherflow.alerts
RABBITMQ_ALERT_QUEUE=weatherflow.notifications.alerts
RABBITMQ_ALERT_ROUTING_KEY=alerts.climate.detected

# --- Telegram Notifications ---
NOTIFICATION_DELIVERY_MODE=log
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
