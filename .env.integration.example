# WeatherFlow cross-service integration tests
# Copy to .env.integration and point these values at disposable test resources.

NODE_ENV=test
JWT_SECRET=integration-test-secret
JWT_EXPIRES_IN=1h

# Use the local docker-compose Mongo service by default. If you point this at
# a remote database, keep the cleanup guard enabled and use a disposable DB.
MONGODB_URI=mongodb://127.0.0.1:27017/weatherflow_integration
WEATHERFLOW_INTEGRATION_ALLOW_DB_CLEANUP=true

# Use a real RabbitMQ instance. The root docker-compose RabbitMQ service works
# if RABBITMQ_DEFAULT_USER/PASS are weatherflow/weatherflow.
RABBITMQ_URL=amqp://weatherflow:weatherflow@localhost:5672
RABBITMQ_ALERT_EXCHANGE=weatherflow.integration.alerts
RABBITMQ_ALERT_QUEUE=weatherflow.integration.notifications.alerts
RABBITMQ_ALERT_ROUTING_KEY=alerts.integration.climate.detected

# The tests start an in-process Notification service and set this dynamically.
NOTIFICATION_SERVICE_URL=http://127.0.0.1:0
NOTIFICATION_DELIVERY_MODE=log

# Telegram is intentionally disabled for integration tests.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
