@startuml c4_level_2_container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

AddRelTag("async", $lineStyle=DashedLine())

LAYOUT_LEFT_RIGHT()

Person(usuario, "Usuario", "Utiliza la Web UI para registrarse, gestionar estaciones y mediciones, configurar suscripciones a alertas y consultar el historial de notificaciones.")
Person(usuarioTelegram, "Usuario de Telegram", "Vincula su cuenta al sistema y recibe alertas climaticas a traves del bot.")

System_Ext(telegram, "Telegram Bot API", "Canal externo para vincular cuentas y entregar alertas al usuario.")
System_Ext(openweather, "OpenWeather API", "Proveedor externo de observaciones meteorologicas.")
ContainerDb_Ext(mongoAtlas, "MongoDB Atlas", "MongoDB", "Colecciones: users, weather_stations, measurements, user_notification_profiles, notifications.")

System_Boundary(weatherflow, "WeatherFlow") {
  Container(web, "Web UI", "React / Vite / nginx", "Interfaz web: autenticacion, estaciones, mediciones, suscripciones, reportes y notificaciones in-app.")
  Container(api, "API service", "NestJS / Node 20", "Puerto 3000. Auth JWT, estaciones, mediciones, reportes, deteccion de alertas, publicador RabbitMQ y proxy REST.")
  Container(notifications, "Notification service", "NestJS / Node 20", "Puerto 3001. Perfiles, webhook Telegram, consumidor RabbitMQ, historial in-app y despacho de alertas.")
  Container(ingestion, "Ingestion service", "NestJS / Node 20", "Puerto 3002. Worker aislado para scheduling, trigger manual, reporte sincronico y adquisicion de datos OpenWeather.")
  ContainerDb(rabbit, "RabbitMQ", "Broker AMQP", "Exchange weatherflow.alerts, cola weatherflow.notifications.alerts, routing key alerts.climate.detected.")
  Container(observability, "Observability stack", "Prometheus / Grafana / Loki / Jaeger / Alertmanager / cAdvisor", "Perfil opcional. Scrapes de metricas, logs centralizados, trazas, dashboard operativo y reglas de alerta.")
}

Rel(api, mongoAtlas, "Lee y escribe usuarios, estaciones y mediciones", "Mongoose / TLS")
Rel(notifications, mongoAtlas, "Lee y escribe perfiles e historial in-app", "Mongoose / TLS")

Rel(usuario, usuarioTelegram, "Vincula su cuenta en Telegram", "")
Rel(usuario, web, "Utiliza", "HTTPS")
Rel(web, api, "Consume API REST y reportes", "HTTPS / JSON + JWT")
Rel(web, notifications, "Consulta historial y abre stream de notificaciones", "HTTP REST / SSE")
Rel(api, notifications, "Proxy de preferencias", "HTTP REST")
Rel(api, ingestion, "Reporte temperatura actual", "HTTP REST interno")
Rel(ingestion, openweather, "Consulta observaciones meteorologicas", "HTTPS / JSON")
Rel(ingestion, api, "Consulta estaciones y registra lecturas por el pipeline de dominio", "HTTP REST")
Rel(api, rabbit, "Publica ClimateAlertDetectedMessage", "AMQP", $tags="async")
Rel(rabbit, notifications, "Consume alertas climaticas", "AMQP", $tags="async")
Rel(notifications, web, "Entrega eventos de notificacion in-app", "SSE")
Rel(notifications, telegram, "Envia alertas y recibe webhooks", "HTTPS")
Rel(usuarioTelegram, telegram, "Interactua con el bot", "HTTPS")
Rel(api, observability, "Expone /metrics, logs y trazas", "Prometheus / Loki / OTLP")
Rel(notifications, observability, "Expone /metrics, logs y trazas", "Prometheus / Loki / OTLP")
Rel(ingestion, observability, "Expone /metrics, logs y trazas", "Prometheus / Loki / OTLP")

@enduml
