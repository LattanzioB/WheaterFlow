@startuml c4_level_2_container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

AddRelTag("async", $lineStyle=DashedLine())

LAYOUT_LEFT_RIGHT()

Person(usuario, "Usuario", "Utiliza la Web UI para registrarse, gestionar estaciones y mediciones, configurar suscripciones a alertas y consultar el historial de notificaciones.")
Person(usuarioTelegram, "Usuario de Telegram", "Vincula su cuenta al sistema y recibe alertas climáticas a través del bot.")

System_Ext(telegram, "Telegram Bot API", "Canal externo para vincular cuentas y entregar alertas al usuario.")
System_Ext(openweather, "OpenWeatherMap API", "Proveedor externo de observaciones meteorológicas.")
ContainerDb_Ext(mongoAtlas, "MongoDB Atlas", "MongoDB", "Colecciones: users, weather_stations, measurements, user_notification_profiles, notifications.")

System_Boundary(weatherflow, "WeatherFlow") {
  Container(web, "Web UI", "React / Vite / nginx", "Interfaz web: autenticación, estaciones, mediciones, suscripciones y notificaciones in-app.")
  Container(api, "API service", "NestJS / Node 20", "Puerto 3000. Auth JWT, estaciones, mediciones, detección de alertas, publicador RabbitMQ y proxy REST al servicio de notificaciones.")
  Container(notifications, "Notification service", "NestJS / Node 20", "Puerto 3001. Perfiles, webhook Telegram, consumidor RabbitMQ, historial in-app y despacho de alertas.")
  Container(ingestion, "Ingestion service", "NestJS / Node 20", "Puerto 3002. Worker aislado para scheduling y adquisición de datos OpenWeather.")
  ContainerDb(rabbit, "RabbitMQ", "Broker AMQP", "Exchange weatherflow.alerts, cola weatherflow.notifications.alerts, routing key alerts.climate.detected.")

  System_Boundary(observability, "Observability stack (perfil Compose 'observability')") {
    Container(prometheus, "Prometheus", "Metrics TSDB", "Scrapea /metrics de API, Notifications, Ingestion y cAdvisor; evalua reglas de alerta.")
    Container(grafana, "Grafana", "Dashboards", "Dashboard 'WeatherFlow Operaciones': hardware, endpoints y negocio.")
    Container(loki, "Loki", "Agregacion de logs", "Recibe logs JSON estructurados enviados por Promtail desde todos los contenedores.")
    Container(jaeger, "Jaeger", "Trazabilidad distribuida", "Colecciona trazas OpenTelemetry de API, Notifications e Ingestion.")
    Container(alertmanager, "Alertmanager", "Enrutamiento de alertas", "Agrupa, deduplica y enruta alertas activas al webhook de demostracion.")
  }
}

Rel(api, mongoAtlas, "Lee y escribe", "Mongoose / TLS")
Rel(notifications, mongoAtlas, "Lee y escribe perfiles e historial in-app", "Mongoose / TLS")
Rel(api, prometheus, "Expone /metrics", "HTTP")
Rel(notifications, prometheus, "Expone /metrics", "HTTP")
Rel(ingestion, prometheus, "Expone /metrics", "HTTP")
Rel(prometheus, alertmanager, "Envia alertas activas", "HTTP")
Rel(grafana, prometheus, "Consulta metricas", "PromQL")
Rel(grafana, loki, "Consulta logs", "LogQL")
Rel(api, jaeger, "Exporta spans", "OTLP/HTTP", $tags="async")
Rel(notifications, jaeger, "Exporta spans", "OTLP/HTTP", $tags="async")
Rel(ingestion, jaeger, "Exporta spans", "OTLP/HTTP", $tags="async")

Rel(usuario, usuarioTelegram, "Vincula su cuenta en Telegram", "")
Rel(usuario, web, "Utiliza", "HTTPS")
Rel(web, api, "Consume API REST", "HTTPS / JSON + JWT")
Rel(web, notifications, "Consulta historial y abre stream de notificaciones", "HTTP REST / SSE")
Rel(api, notifications, "Proxy de preferencias", "HTTP REST")
Rel(ingestion, openweather, "Consulta observaciones meteorológicas actuales", "HTTPS / JSON")
Rel(ingestion, api, "Consulta estaciones y registra lecturas por el pipeline de dominio", "HTTP REST")
Rel(api, rabbit, "Publica ClimateAlertDetectedMessage", "AMQP", $tags="async")
Rel(rabbit, notifications, "Consume alertas climáticas", "AMQP", $tags="async")
Rel(notifications, web, "Entrega eventos de notificacion in-app", "SSE")
Rel(notifications, telegram, "Envía alertas y recibe webhooks", "HTTPS")
Rel(usuarioTelegram, telegram, "Interactúa con el bot", "HTTPS")

@enduml
