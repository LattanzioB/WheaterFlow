@startuml c4_level_3_ingestion
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()

System_Ext(openweather, "OpenWeather API", "Proveedor externo de observaciones meteorológicas por coordenada.")
Container(api, "API service", "NestJS", "Dueña del dominio de estaciones y mediciones; expone la frontera interna de ingesta y consume la frontera de temperatura actual.")

Container_Boundary(ingestion, "Ingestion service (apps/ingestion)") {
  Component(healthController, "HealthController", "NestJS", "GET /health.")
  Component(ingestionController, "IngestionController", "NestJS", "POST /internal/ingestion/run: disparo manual de un ciclo.")
  Component(currentWeatherController, "CurrentWeatherController", "NestJS", "GET /internal/weather/current: lectura sincrónica para el reporte de temperatura actual.")
  Component(manualGuard, "ManualIngestionTokenGuard", "Infrastructure", "Valida x-ingestion-token con comparación de tiempo constante.")
  Component(scheduler, "IngestionScheduler", "NestJS Schedule", "Registra el job INGESTION_CRON; salta ejecuciones programadas superpuestas.")
  Component(cycleService, "RunIngestionCycleService", "Application", "Orquesta un ciclo: descubre estaciones, acota la concurrencia hacia OWM, aplica el fallback de cache solo en ciclos programados y emite un resumen estructurado.")
  Component(stationCatalogAdapter, "ApiWeatherStationCatalogAdapter", "Infrastructure", "Puerto WeatherStationCatalog: obtiene de la API las estaciones con provider=openweather.")
  Component(resilientProvider, "ResilientWeatherDataProvider", "Infrastructure", "Puerto WeatherDataProvider: timeout, circuit breaker, bulkhead y cache de última lectura válida alrededor del adaptador crudo de OpenWeather.")
  Component(owmAdapter, "OpenWeatherMapAdapter", "Infrastructure", "Cliente HTTP crudo de OpenWeather más el mapper de respuesta; normaliza a Celsius, porcentaje, hPa, observedAt y externalId.")
  Component(submitterAdapter, "ApiMeasurementSubmitterAdapter", "Infrastructure", "Puerto MeasurementSubmitter: timeout, circuit breaker, bulkhead, reintentos seguros con backoff/jitter y una clave de idempotencia determinística.")
  Component(ingestionMetrics, "IngestionMetrics", "Infrastructure", "Contadores/gauges de Prometheus para los resultados de cada ciclo.")
  Component(owmMetrics, "OpenWeatherResilienceMetrics", "Infrastructure", "Métricas de Prometheus de resultado de request, falla tipada, estado del breaker y entradas de cache.")
  Component(httpBoundaryMetrics, "HttpBoundaryMetrics", "Infrastructure", "Métricas de Prometheus de request/breaker para la frontera REST ingestion-hacia-API.")
  Component(metricsController, "MetricsController (libs/shared)", "NestJS", "Expone ingestionMetrics/owmMetrics/httpBoundaryMetrics en /metrics.")
  Component(tracingInstrumentation, "OpenTelemetry SDK (tracing.ts)", "Infrastructure", "Instrumentación automática de HTTP/Mongo; exporta spans por OTLP.")
}

System_Ext(prometheus, "Prometheus", "Scrapea las métricas de Ingestion cada 15s.")
System_Ext(jaeger, "Jaeger", "Colecciona trazas distribuidas OTLP.")

Rel(scheduler, cycleService, "Ejecuta ciclo programado")
Rel(ingestionController, manualGuard, "Protegido por")
Rel(ingestionController, cycleService, "Ejecuta ciclo manual")
Rel(currentWeatherController, manualGuard, "Protegido por")
Rel(api, currentWeatherController, "GET /internal/weather/current?latitude&longitude", "HTTP REST")
Rel(currentWeatherController, resilientProvider, "Obtiene el clima actual")

Rel(cycleService, stationCatalogAdapter, "Lista estaciones openweather")
Rel(cycleService, resilientProvider, "Obtiene el clima actual, acotado por OWM_CONCURRENCY_LIMIT")
Rel(cycleService, submitterAdapter, "Envía la medición (con correlationId)")
Rel(cycleService, ingestionMetrics, "Registra el resumen del ciclo")

Rel(stationCatalogAdapter, api, "GET /internal/ingestion/stations", "HTTP REST + x-ingestion-token")
Rel(submitterAdapter, api, "POST /internal/ingestion/measurements", "HTTP REST + x-ingestion-token + idempotency key")
Rel(submitterAdapter, httpBoundaryMetrics, "Registra resultado y estado del breaker (ingestion_to_api)")

Rel(resilientProvider, owmAdapter, "Delega cuando el breaker está cerrado y hay bulkhead disponible")
Rel(resilientProvider, owmMetrics, "Registra resultado, falla tipada, estado del breaker y entradas de cache")
Rel(owmAdapter, openweather, "Consulta clima actual por coordenada", "HTTPS")

Rel(ingestionMetrics, metricsController, "Registra series")
Rel(owmMetrics, metricsController, "Registra series")
Rel(httpBoundaryMetrics, metricsController, "Registra series")
Rel(metricsController, prometheus, "Expone /metrics", "HTTP")
Rel(tracingInstrumentation, jaeger, "Exporta spans", "OTLP/HTTP")

@enduml
