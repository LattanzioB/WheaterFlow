@startuml c4_level_3_notifications
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

AddRelTag("async", $lineStyle=DashedLine())

LAYOUT_TOP_DOWN()

System_Ext(telegram, "Telegram Bot API", "External channel for chat linking and Telegram alert delivery.")

Container(web, "Web UI", "React", "NotificationsContext, header bell, toast, and /notifications page.")
Container(api, "API service", "NestJS", "Publishes ClimateAlertDetectedMessage and proxies preference REST routes.")

Container_Boundary(notifications, "Notification service (apps/notifications)") {
  Component(prefsController, "NotificationPreferencesController", "NestJS", "REST API for profiles, subscriptions, and delivery channels.")
  Component(historyController, "NotificationsController", "NestJS", "GET /notifications, PATCH /notifications/:id/read, PATCH /notifications/read-all.")
  Component(streamController, "NotificationStreamController", "NestJS SSE", "GET /notifications/stream with bearer JWT or ?token fallback.")
  Component(telegramWebhook, "TelegramWebhookController", "NestJS", "Telegram /link webhook and chat binding.")
  Component(preferenceServices, "Preference services", "Application", "Subscribe, unsubscribe, delivery channels, and Telegram link codes.")
  Component(historyServices, "Notification history services", "Application", "List notifications, count unread, mark one/all read.")
  Component(notificationService, "NotificationService", "Application", "Filters subscribers by station and alert type, then resolves delivery targets.")
  Component(eventBus, "EventEmitter2", "Application event bus", "notification.delivered fan-out for connected SSE clients.")
  Component(profileAggregate, "UserNotificationProfile", "Domain", "Station alert preferences and deliveryChannels.inApp.")
  Component(notificationEntity, "Notification", "Domain", "Persisted in-app alert history row.")
  Component(profileRepository, "MongoNotificationProfileRepository", "Infrastructure", "user_notification_profiles collection.")
  Component(notificationRepository, "MongoNotificationRepository", "Infrastructure", "notifications collection; indexes userId+createdAt and unique userId+messageId.")
  Component(consumer, "RabbitMqClimateAlertConsumerAdapter", "Infrastructure", "Consumes, validates, acks/nacks ClimateAlertDetectedMessage.")
  Component(compositeNotifier, "CompositeAlertNotifierAdapter", "Infrastructure", "Delegates to Log, Telegram, and InApp notifiers.")
  Component(logNotifier, "LogAlertNotifierAdapter", "Infrastructure", "Local/test delivery.")
  Component(telegramNotifier, "TelegramAlertNotifierAdapter", "Infrastructure", "Telegram sendMessage.")
  Component(inAppNotifier, "InAppAlertNotifierAdapter", "Infrastructure", "Persists Notification and emits the SSE fan-out event.")
}

ContainerDb_Ext(mongo, "MongoDB", "MongoDB", "user_notification_profiles and notifications collections.")
ContainerQueue(rabbit, "RabbitMQ", "AMQP", "weatherflow.alerts exchange, weatherflow.notifications.alerts queue.")

Rel(web, historyController, "Hydrates history and read state", "HTTP REST")
Rel(streamController, web, "Streams live notification events", "SSE")
Rel(api, prefsController, "Proxies preference mutations", "HTTP REST")
Rel(api, rabbit, "Publishes climate alerts", "AMQP", $tags="async")
Rel(telegram, telegramWebhook, "Webhook", "HTTPS")

Rel(prefsController, preferenceServices, "Delegates")
Rel(preferenceServices, profileAggregate, "Orchestrates")
Rel(preferenceServices, profileRepository, "Persists")
Rel(historyController, historyServices, "Delegates")
Rel(historyServices, notificationRepository, "Reads and updates")
Rel(telegramWebhook, profileRepository, "Updates chatId")

Rel(rabbit, consumer, "Delivers climate alert", "AMQP", $tags="async")
Rel(consumer, notificationService, "handleClimateAlert(message)")
Rel(notificationService, profileRepository, "Loads subscribed profiles")
Rel(notificationService, compositeNotifier, "Dispatches resolved targets")
Rel(compositeNotifier, logNotifier, "Log mode")
Rel(compositeNotifier, telegramNotifier, "Telegram mode")
Rel(compositeNotifier, inAppNotifier, "in-app channel")
Rel(inAppNotifier, notificationRepository, "Saves")
Rel(inAppNotifier, notificationEntity, "Creates")
Rel(inAppNotifier, eventBus, "Emits notification.delivered")
Rel(eventBus, streamController, "Filters by userId")

Rel(profileRepository, mongo, "Reads/writes documents", "Mongoose")
Rel(notificationRepository, mongo, "Reads/writes documents", "Mongoose")
Rel(telegramNotifier, telegram, "Sends alerts", "HTTPS")

Lay_R(historyController, web)
Lay_R(streamController, web)
Lay_R(telegramWebhook, telegram)
Lay_R(telegramNotifier, telegram)

@enduml
