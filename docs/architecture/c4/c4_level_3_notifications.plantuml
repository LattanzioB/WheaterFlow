@startuml c4_level_3_notifications
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

AddRelTag("async", $lineStyle=DashedLine())

LAYOUT_TOP_DOWN()

System_Ext(telegram, "Telegram Bot API", "Canal externo para vincular cuentas y entregar alertas al usuario.")

Container(web, "Web UI", "React", "NotificationsContext, campana del header, toast y la pantalla /notifications.")
Container(api, "API service", "NestJS", "Publica ClimateAlertDetectedMessage y hace de proxy REST de las rutas de preferencias.")

Container_Boundary(notifications, "Notification service (apps/notifications)") {
  Component(prefsController, "NotificationPreferencesController", "NestJS", "API REST de perfiles, suscripciones y canales de entrega.")
  Component(historyController, "NotificationsController", "NestJS", "GET /notifications, PATCH /notifications/:id/read, PATCH /notifications/read-all.")
  Component(streamController, "NotificationStreamController", "NestJS SSE", "GET /notifications/stream con bearer JWT o fallback por ?token.")
  Component(telegramWebhook, "TelegramWebhookController", "NestJS", "Webhook /link de Telegram y vinculación del chat.")
  Component(preferenceServices, "Preference services", "Application", "Suscribir, desuscribir, canales de entrega y códigos de vinculación de Telegram.")
  Component(historyServices, "Notification history services", "Application", "Listar notificaciones, contar no leídas, marcar una o todas como leídas.")
  Component(notificationService, "NotificationService", "Application", "Filtra suscriptores por estación y tipo de alerta, y resuelve los destinos de entrega.")
  Component(eventBus, "EventEmitter2", "Application event bus", "Fan-out de notification.delivered hacia los clientes SSE conectados.")
  Component(profileAggregate, "UserNotificationProfile", "Domain", "Preferencias de alerta por estación y deliveryChannels.inApp.")
  Component(notificationEntity, "Notification", "Domain", "Fila persistida del historial de alertas in-app.")
  Component(profileRepository, "MongoNotificationProfileRepository", "Infrastructure", "Colección user_notification_profiles.")
  Component(notificationRepository, "MongoNotificationRepository", "Infrastructure", "Colección notifications; índices userId+createdAt y único userId+messageId.")
  Component(consumer, "RabbitMqClimateAlertConsumerAdapter", "Infrastructure", "Consume, valida y hace ack/nack de ClimateAlertDetectedMessage.")
  Component(compositeNotifier, "CompositeAlertNotifierAdapter", "Infrastructure", "Delega en los notificadores Log, Telegram e InApp.")
  Component(logNotifier, "LogAlertNotifierAdapter", "Infrastructure", "Entrega para entornos locales y de test.")
  Component(telegramNotifier, "TelegramAlertNotifierAdapter", "Infrastructure", "sendMessage de Telegram.")
  Component(inAppNotifier, "InAppAlertNotifierAdapter", "Infrastructure", "Persiste Notification y emite el evento de fan-out SSE.")
  Component(metricsController, "MetricsController (libs/shared)", "NestJS", "Expone métricas de Prometheus en /metrics.")
  Component(tracingInstrumentation, "OpenTelemetry SDK (tracing.ts)", "Infrastructure", "Instrumentación automática de HTTP/Mongo/AMQP; exporta spans por OTLP.")
}

ContainerDb_Ext(mongo, "MongoDB", "MongoDB", "Colecciones user_notification_profiles y notifications.")
ContainerQueue(rabbit, "RabbitMQ", "AMQP", "Exchange weatherflow.alerts, cola weatherflow.notifications.alerts.")
System_Ext(prometheus, "Prometheus", "Scrapea las métricas de Notification service cada 15s.")
System_Ext(jaeger, "Jaeger", "Colecciona trazas distribuidas OTLP.")

Rel(web, historyController, "Hidrata historial y estado de lectura", "HTTP REST")
Rel(streamController, web, "Transmite eventos de notificación en vivo", "SSE")
Rel(api, prefsController, "Proxy de mutaciones de preferencias", "HTTP REST")
Rel(api, rabbit, "Publica alertas climáticas", "AMQP", $tags="async")
Rel(telegram, telegramWebhook, "Webhook", "HTTPS")

Rel(prefsController, preferenceServices, "Delega")
Rel(preferenceServices, profileAggregate, "Orquesta")
Rel(preferenceServices, profileRepository, "Persiste")
Rel(historyController, historyServices, "Delega")
Rel(historyServices, notificationRepository, "Lee y actualiza")
Rel(telegramWebhook, profileRepository, "Actualiza chatId")

Rel(rabbit, consumer, "Entrega la alerta climática", "AMQP", $tags="async")
Rel(consumer, notificationService, "Procesa la alerta climática")
Rel(notificationService, profileRepository, "Carga los perfiles suscriptos")
Rel(notificationService, compositeNotifier, "Despacha los destinos resueltos")
Rel(compositeNotifier, logNotifier, "Modo log")
Rel(compositeNotifier, telegramNotifier, "Modo Telegram")
Rel(compositeNotifier, inAppNotifier, "Canal in-app")
Rel(inAppNotifier, notificationRepository, "Guarda")
Rel(inAppNotifier, notificationEntity, "Crea")
Rel(inAppNotifier, eventBus, "Emite notification.delivered")
Rel(eventBus, streamController, "Filtra por userId")

Rel(profileRepository, mongo, "Lee y escribe documentos", "Mongoose")
Rel(notificationRepository, mongo, "Lee y escribe documentos", "Mongoose")
Rel(telegramNotifier, telegram, "Envía alertas", "HTTPS")
Rel(metricsController, prometheus, "Expone /metrics", "HTTP")
Rel(tracingInstrumentation, jaeger, "Exporta spans", "OTLP/HTTP", $tags="async")

Lay_R(historyController, web)
Lay_R(streamController, web)
Lay_R(telegramWebhook, telegram)
Lay_R(telegramNotifier, telegram)

@enduml
