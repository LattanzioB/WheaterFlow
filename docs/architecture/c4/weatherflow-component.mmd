flowchart LR
  classDef actor fill:#e8f0fe,stroke:#1a73e8,color:#0b57d0,stroke-width:1.5px;
  classDef module fill:#e6f4ea,stroke:#188038,color:#0d652d,stroke-width:1.5px;
  classDef adapter fill:#fef7e0,stroke:#f29900,color:#7c4a03,stroke-width:1.5px;
  classDef external fill:#fce8e6,stroke:#d93025,color:#a50e0e,stroke-width:1.5px;

  client["User and API clients"]:::actor
  telegramUser["Telegram user"]:::actor
  mongo["MongoDB Atlas"]:::external
  rabbit["RabbitMQ"]:::external
  telegram["Telegram Bot API"]:::external

  subgraph api["API service - apps/api"]
    authController["AuthController"]:::module
    prefsController["UserNotificationPreferencesController\nJWT-protected preference facade"]:::module
    stationsController["WeatherStationsController"]:::module
    measurementsController["MeasurementsController"]:::module

    authServices["RegisterUserService\nLoginUserService"]:::module
    stationServices["Create/list/get/update/delete station services"]:::module
    queryService["QueryMeasurementsService\nfilter by station name, ranges,\ndates, and alert state"]:::module
    recordService["RecordMeasurementService\npersist measurement first,\nthen publish alert message"]:::module

    weatherDomain["WeatherStation aggregate\nMeasurement aggregate\nAlert evaluation value objects"]:::module
    apiRepositories["Mongo repositories\nUser, WeatherStation, Measurement"]:::adapter
    notificationClient["HttpNotificationServiceClient\nREST port to Notification service"]:::adapter
    alertPublisher["AlertPublisher port\nRabbitMqAlertPublisherAdapter"]:::adapter
  end

  subgraph notificationBoundary["Notification service - apps/notifications"]
    notificationPrefsController["NotificationPreferencesController\nprofile and subscription REST API"]:::module
    notificationsController["NotificationsController\nJWT-protected history + read state"]:::module
    notificationStreamController["NotificationStreamController\nJWT-protected SSE stream"]:::module
    telegramWebhook["TelegramWebhookController"]:::module
    preferenceServices["Subscribe/unsubscribe/update preferences\nUpdateDeliveryChannelsService\nCreateTelegramLinkCodeService"]:::module
    notificationHistoryServices["GetNotificationsService\nMarkNotificationReadService\nMarkAllNotificationsReadService"]:::module
    notificationService["NotificationService\nFilter subscribers by station + alert type\nResolve delivery targets"]:::module
    notificationAggregate["Notification aggregate\nper-user alert history"]:::module
    profileAggregate["UserNotificationProfile aggregate\nstation preferences + delivery channels"]:::module
    profileRepository["INotificationProfileRepository\nMongoNotificationProfileRepository"]:::adapter
    notificationRepository["INotificationRepository\nMongoNotificationRepository"]:::adapter
    consumer["RabbitMqClimateAlertConsumerAdapter\nvalidate, ack, nack"]:::adapter
    streamEvents["EventEmitter2\nnotification.delivered"]:::adapter
    notifiers["AlertNotifier port\nComposite, Log, Telegram adapters\nInApp adapter"]:::adapter
  end

  client --> authController
  client --> prefsController
  client --> notificationsController
  client --> notificationStreamController
  client --> stationsController
  client --> measurementsController

  authController --> authServices --> apiRepositories
  stationsController --> stationServices --> weatherDomain
  measurementsController --> queryService --> apiRepositories
  measurementsController --> recordService --> weatherDomain
  stationServices --> apiRepositories
  recordService --> apiRepositories
  recordService --> alertPublisher --> rabbit
  prefsController --> notificationClient --> notificationPrefsController

  notificationPrefsController --> preferenceServices --> profileAggregate
  notificationsController --> notificationHistoryServices --> notificationRepository
  notificationStreamController --> streamEvents
  preferenceServices --> profileRepository
  telegramWebhook --> profileRepository
  rabbit --> consumer --> notificationService
  notificationService --> profileRepository
  notificationService --> notifiers
  notifiers --> telegram
  notifiers --> notificationAggregate --> notificationRepository
  notifiers --> streamEvents

  apiRepositories --> mongo
  profileRepository --> mongo
  notificationRepository --> mongo
  telegramUser --> telegram
  telegram --> telegramWebhook
