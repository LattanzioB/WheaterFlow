flowchart LR
  classDef person fill:#e8f0fe,stroke:#1a73e8,color:#0b57d0,stroke-width:1.5px;
  classDef container fill:#e6f4ea,stroke:#188038,color:#0d652d,stroke-width:1.5px;
  classDef database fill:#fce8e6,stroke:#d93025,color:#a50e0e,stroke-width:1.5px;
  classDef queue fill:#fef7e0,stroke:#f29900,color:#7c4a03,stroke-width:1.5px;
  classDef external fill:#fff8e1,stroke:#b06000,color:#5f3b00,stroke-width:1.5px;

  clients["Users, Swagger, and station clients"]:::person
  telegramUser["Telegram user"]:::person

  subgraph boundary["WeatherFlow Delivery II"]
    api["API service\nNestJS app on port 3000\nAuth, Users facade, Stations,\nMeasurements, alert detection,\nRabbitMQ publisher, Notification REST client"]:::container
    notifications["Notification service\nNestJS app on port 3001\nNotification preferences REST API,\nTelegram webhook, RabbitMQ consumer,\nsubscriber filtering, delivery adapters"]:::container
    rabbit[("RabbitMQ\nTopic exchange: weatherflow.alerts\nQueue: weatherflow.notifications.alerts\nRouting key: alerts.climate.detected")]:::queue
  end

  mongo[("MongoDB Atlas\nusers, weather_stations, measurements,\nuser_notification_profiles")]:::database
  telegram["Telegram Bot API"]:::external

  clients -->|"HTTPS/JSON REST + JWT"| api
  api -->|"Mongoose read/write\nAPI-owned collections"| mongo
  api -->|"HTTP REST\npreference proxy"| notifications
  api -->|"AMQP publish\nClimateAlertDetectedMessage"| rabbit
  rabbit -->|"AMQP consume\nack/nack handling"| notifications
  notifications -->|"Mongoose read/write\nnotification-owned collection"| mongo
  notifications -->|"HTTPS sendMessage"| telegram
  telegram -->|"Webhook /link command"| notifications
  telegramUser -->|"Bot chat"| telegram
