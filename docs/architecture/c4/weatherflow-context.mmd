flowchart LR
  classDef person fill:#e8f0fe,stroke:#1a73e8,color:#0b57d0,stroke-width:1.5px;
  classDef system fill:#e6f4ea,stroke:#188038,color:#0d652d,stroke-width:1.5px;
  classDef external fill:#fef7e0,stroke:#f29900,color:#7c4a03,stroke-width:1.5px;

  client["User and API clients\nRegister, manage stations, record measurements,\nconfigure preferences, and query weather data"]:::person
  stationPublisher["Station data publisher\nSends measurement readings"]:::person
  telegramUser["Telegram user\nLinks chat and receives alerts"]:::person

  subgraph weatherflow["WeatherFlow System Boundary"]
    api["API service\nAuthenticated weather-data API,\nstation and measurement workflows,\nalert detection, and preference proxy"]
    notifications["Notification service\nNotification profile ownership,\nalert consumption, subscriber targeting,\nand delivery orchestration"]
    rabbit["RabbitMQ\nDurable climate-alert exchange and queue"]
  end

  mongo["MongoDB Atlas\nManaged persistence for API data\nand notification profiles"]:::external
  telegram["Telegram Bot API\nExternal bot delivery and webhook source"]:::external

  api:::system
  notifications:::system
  rabbit:::external

  client -->|"HTTPS/JSON REST"| api
  stationPublisher -->|"POST /measurements"| api
  api -->|"REST preference proxy"| notifications
  api -->|"Publish ClimateAlertDetectedMessage"| rabbit
  rabbit -->|"Consume climate alerts"| notifications
  api -->|"Read/write users, stations, measurements"| mongo
  notifications -->|"Read/write notification profiles"| mongo
  notifications -->|"Send alerts"| telegram
  telegram -->|"POST /notifications/telegram/webhook"| notifications
  telegramUser -->|"Chat with bot"| telegram
