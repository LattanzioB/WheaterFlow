sequenceDiagram
    autonumber
    participant Cron as IngestionScheduler
    participant Cycle as RunIngestionCycleService
    participant APIClient as WeatherStationCatalog
    participant API as API service
    participant OWM as ResilientWeatherDataProvider / OWM
    participant Submitter as MeasurementSubmitter
    participant Domain as RecordMeasurementService
    participant Mongo as MongoDB
    participant RabbitMQ

    Cron->>Cycle: execute("scheduled")
    Cycle->>APIClient: listOpenWeatherStations()
    APIClient->>API: GET /internal/ingestion/stations<br/>x-ingestion-token
    API-->>APIClient: provider=openweather stations
    APIClient-->>Cycle: IngestionStation[]

    loop Active stations, bounded concurrency
        Cycle->>OWM: getCurrentWeather(location)
        alt Provider success
            OWM-->>Cycle: normalized reading
            Cycle->>Submitter: submitMeasurement(reading, cycleId)
            loop Safe transient API failures
                Submitter->>API: POST /internal/ingestion/measurements<br/>token + correlation + same idempotency key
            end
            API->>Domain: execute(openweather command)
            Domain->>Mongo: insert if absent
            opt Critical measurement created
                Domain->>RabbitMQ: ClimateAlertDetectedMessage<br/>correlationId=cycleId
            end
            API-->>Submitter: persisted or existing measurement
            Submitter-->>Cycle: measurement result
        else Provider failure with valid cache
            OWM-->>Cycle: cached reading + age metadata
            Cycle->>Submitter: submitMeasurement(cached reading, cycleId)
            loop Safe transient API failures
                Submitter->>API: POST /internal/ingestion/measurements<br/>token + correlation + same idempotency key
            end
            API->>Domain: execute(openweather command)
            Domain->>Mongo: insert if absent
            API-->>Submitter: persisted or existing measurement
            Submitter-->>Cycle: measurement result + fallback metadata
        else Provider failure without cache
            OWM--xCycle: typed error
            Note over Cycle: Failure is recorded, the batch continues
        end
    end

    Note over Cycle: Inactive stations are skipped
    Cycle-->>Cron: structured cycle summary
