classDiagram
direction LR

%% Auth ports and adapters
class PasswordHasher["PasswordHasher (Port)"] {
  +hash(password)
  +compare(password, passwordHash)
}

class TokenService["TokenService (Port)"] {
  +generateToken(payload)
}

class AuthTokenPayload["AuthTokenPayload (Payload)"] {
  +sub
  +email
}

class BcryptPasswordHasher["BcryptPasswordHasher (Adapter)"] {
  +hash(password)
  +compare(password, passwordHash)
}

class JwtTokenService["JwtTokenService (Adapter)"] {
  +generateToken(payload)
}

%% Persistence ports and adapters
class IUserRepository["IUserRepository (Port)"] {
  +findById(id)
  +findByEmail(email)
  +save(user)
  +delete(id)
  +findAll()
}

class INotificationProfileRepository["INotificationProfileRepository (Port)"] {
  +findByUserId(userId)
  +findByTelegramLinkCode(code)
  +findSubscribersByStationId(stationId)
  +save(profile)
  +delete(userId)
}

class INotificationServiceClient["INotificationServiceClient (Port)"] {
  +getProfile(userId)
  +subscribe(request)
  +unsubscribe(request)
  +updateAlertPreferences(request)
  +updateDeliveryChannels(request)
  +createTelegramLinkCode(userId)
}

class IStationRepository["IStationRepository (Port)"] {
  +findById(id)
  +findByIds(ids)
  +findByOwnerId(ownerId)
  +save(station)
  +delete(id)
  +findAll()
}

class IMeasurementRepository["IMeasurementRepository (Port)"] {
  +findById(id)
  +findByStationId(stationId)
  +findLatestByStationIds(stationIds)
  +save(measurement)
  +delete(id)
  +findWithFilters(filters)
}

class MeasurementFilters["MeasurementFilters (QueryModel)"] {
  +stationName
  +tempMin
  +tempMax
  +alertOnly
}

class MongoUserRepository["MongoUserRepository (Adapter)"] {
  +findById(id)
  +findByEmail(email)
  +save(user)
}

class MongoNotificationProfileRepository["MongoNotificationProfileRepository (Adapter)"] {
  +findByUserId(userId)
  +findByTelegramLinkCode(code)
  +save(profile)
}

class HttpNotificationServiceClient["HttpNotificationServiceClient (Adapter)"] {
  +getProfile(userId)
  +subscribe(request)
}

class MongoWeatherStationRepository["MongoWeatherStationRepository (Adapter)"] {
  +findById(id)
  +findByOwnerId(ownerId)
  +save(station)
}

class MongoMeasurementRepository["MongoMeasurementRepository (Adapter)"] {
  +findById(id)
  +findByStationId(stationId)
  +save(measurement)
  +findWithFilters(filters)
}

class UserDocumentMapper["UserDocumentMapper (Mapper)"]
class WeatherStationDocumentMapper["WeatherStationDocumentMapper (Mapper)"]
class MeasurementDocumentMapper["MeasurementDocumentMapper (Mapper)"]
class UserPersistenceModel["UserPersistenceModel (PersistenceModel)"]
class WeatherStationPersistenceModel["WeatherStationPersistenceModel (PersistenceModel)"]
class MeasurementPersistenceModel["MeasurementPersistenceModel (PersistenceModel)"]

%% Notifications port and adapter
class AlertNotifier["AlertNotifier (Port)"] {
  +sendMeasurementAlert(notification)
}

class MeasurementAlertNotification["MeasurementAlertNotification (RequestModel)"] {
  +userId
  +deliveryTargets
  +measurementId
  +stationId
  +stationName
  +alertType
  +reportedAt
  +temperature
  +humidity
  +pressure
}

class NotificationDeliveryTarget["NotificationDeliveryTarget (RequestModel)"] {
  +channel
  +destination
}

class AlertType["AlertType (DomainEnum)"]

class TelegramAlertNotifierAdapter["TelegramAlertNotifierAdapter (TelegramAdapter)"] {
  +sendMeasurementAlert(notification)
}

PasswordHasher <|.. BcryptPasswordHasher
TokenService <|.. JwtTokenService
JwtTokenService ..> AuthTokenPayload : signs

IUserRepository <|.. MongoUserRepository
INotificationProfileRepository <|.. MongoNotificationProfileRepository
INotificationServiceClient <|.. HttpNotificationServiceClient
IStationRepository <|.. MongoWeatherStationRepository
IMeasurementRepository <|.. MongoMeasurementRepository
IMeasurementRepository ..> MeasurementFilters : query contract

MongoUserRepository ..> UserDocumentMapper : maps
MongoWeatherStationRepository ..> WeatherStationDocumentMapper : maps
MongoMeasurementRepository ..> MeasurementDocumentMapper : maps
UserDocumentMapper ..> UserPersistenceModel : reads and writes
WeatherStationDocumentMapper ..> WeatherStationPersistenceModel : reads and writes
MeasurementDocumentMapper ..> MeasurementPersistenceModel : reads and writes
MongoMeasurementRepository ..> WeatherStationPersistenceModel : resolves station name filters

AlertNotifier <|.. TelegramAlertNotifierAdapter
TelegramAlertNotifierAdapter ..> MeasurementAlertNotification : formats
MeasurementAlertNotification *-- NotificationDeliveryTarget : delivery targets
MeasurementAlertNotification --> AlertType : alert type
