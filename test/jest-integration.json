{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "roots": ["<rootDir>/test", "<rootDir>/apps/notifications/test"],
  "testRegex": ".*\\.(integration-spec|int-spec)\\.ts$",
  "setupFiles": ["<rootDir>/test/integration/setup-integration-env.ts"],
  "moduleNameMapper": {
    "^@api/(.*)$": "<rootDir>/apps/api/src/$1",
    "^@notifications/(.*)$": "<rootDir>/apps/notifications/src/$1",
    "^@ingestion/(.*)$": "<rootDir>/apps/ingestion/src/$1",
    "^@shared/(.*)$": "<rootDir>/libs/shared/src/$1",
    "^@contracts$": "<rootDir>/libs/contracts/src/index.ts",
    "^@contracts/(.*)$": "<rootDir>/libs/contracts/src/$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript",
            "decorators": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          }
        }
      }
    ]
  }
}
